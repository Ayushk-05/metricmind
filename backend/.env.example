# Application settings
APP_NAME="MetricMind API"
APP_VERSION="0.1.0"
DEBUG=True

# Database Configuration (PostgreSQL + psycopg v3)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://metricmind_user:YOUR_PASSWORD_HERE@localhost:5432/metricmind
